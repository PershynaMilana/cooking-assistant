# Base URL of the API. Leave unset in dev: Next forwards /api to the backend, keeping
# requests same-origin so the httpOnly auth cookie is first-party.
# Set this only for deployments, where the API lives on its own domain.
# NEXT_PUBLIC_API_URL=

# Public origin of the site. Metadata resolves canonical and social URLs against it.
# Defaults to http://localhost:8080 in development. Required for a production build,
# which fails rather than ship canonical and social URLs pointing at localhost.
# NEXT_PUBLIC_SITE_URL=

# Backend address the server itself calls: the dev proxy for /api, and every request a
# server-rendered page makes. Never sent to the browser, so it stays on the private network.
# Defaults to http://localhost:3000.
# API_INTERNAL_URL=
